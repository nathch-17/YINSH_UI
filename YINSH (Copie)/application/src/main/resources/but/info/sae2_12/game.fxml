<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<?import java.lang.String?>
<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      
      fx:controller="but.info.sae2_12.controllers.GameController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Button fx:id="btnNewGame" mnemonicParsing="false" onAction="#handleNewGame" prefHeight="30.0" prefWidth="100.0" text="Nouvelle partie" />
            <Button fx:id="btnState1" mnemonicParsing="false" onAction="#handleState1" prefHeight="30.0" prefWidth="100.0" text="State1" />
            <Button fx:id="btnState2" mnemonicParsing="false" onAction="#handleState2" prefHeight="30.0" prefWidth="100.0" text="State2" />
            <Button fx:id="btnState3" mnemonicParsing="false" onAction="#handleState3" prefHeight="30.0" prefWidth="100.0" text="State3" />
         </children>
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </HBox>
      <TitledPane animated="false" collapsible="false" text="Édition mode">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="8.0">
               <children>
                  <CheckBox fx:id="chkEditMode" mnemonicParsing="false" text="Activer/Désactiver">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </CheckBox>
                  <VBox fx:id="vboxTypeTeam" prefHeight="200.0" prefWidth="100.0" disable="true">
                     <children>
                        <Label text="Type : ">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <padding>
                              <Insets top="5.0" />
                           </padding>
                        </Label>
                        <RadioButton fx:id="radioPion" mnemonicParsing="false" selected="true" text="Pion">
                           <userData><String fx:value="Pawn"/></userData>
                           <toggleGroup>
                              <ToggleGroup fx:id="typeToggleGroup" />
                           </toggleGroup>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <padding>
                              <Insets bottom="2.0" left="20.0" top="2.0" />
                           </padding>
                        </RadioButton>
                        <RadioButton fx:id="radioRing" mnemonicParsing="false" text="Anneau" toggleGroup="$typeToggleGroup">
                           <userData><String fx:value="Ring"/></userData>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <padding>
                              <Insets bottom="2.0" left="20.0" top="2.0" />
                           </padding>
                        </RadioButton>
                        <Label text="Equipe : ">
                           <padding>
                              <Insets top="5.0" />
                           </padding>
                        </Label>
                        <RadioButton fx:id="radioBlack" mnemonicParsing="false" selected="true" text="Noir">
                           <userData><String fx:value="Black"/></userData>
                           <toggleGroup>
                              <ToggleGroup fx:id="teamToggleGroup" />
                           </toggleGroup>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <padding>
                              <Insets bottom="2.0" left="20.0" top="2.0" />
                           </padding>
                        </RadioButton>
                        <RadioButton fx:id="radioWhite" mnemonicParsing="false" text="Blanc" toggleGroup="$teamToggleGroup">
                           <userData><String fx:value="White"/></userData>
                           <padding>
                              <Insets bottom="2.0" left="20.0" top="2.0" />
                           </padding>
                        </RadioButton>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content>
         <font>
            <Font size="15.0" />
         </font>
      </TitledPane>
      <TitledPane collapsible="false" prefHeight="200.0" prefWidth="200.0" text="Couleurs">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="8.0">
               <children>
                  <Label text="Couleur 1 :">
                     <padding>
                        <Insets top="5.0" />
                     </padding>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <ColorPicker fx:id="colorPicker1" prefWidth="100.0">
                     <padding>
                        <Insets bottom="5.0" />
                     </padding>
                     <value>
                        <Color red="0.501960813999176" green="0.501960813999176" blue="0.501960813999176" />
                     </value>
                  </ColorPicker>
                  <Label text="Couleur 2 : ">
                     <padding>
                        <Insets top="5.0" />
                     </padding>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <ColorPicker fx:id="colorPicker2" prefWidth="100.0">
                     <padding>
                        <Insets bottom="5.0" />
                     </padding>
                     <value>
                        <Color red="0.3684210479259491" green="0.36500975489616394" blue="0.36500975489616394" />
                     </value>
                  </ColorPicker>
                  <Label text="Couleur 3 :">
                     <padding>
                        <Insets top="5.0" />
                     </padding>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <ColorPicker fx:id="colorPicker3" prefWidth="100.0">
                     <padding>
                        <Insets bottom="5.0" />
                     </padding>
                     <value>
                        <Color red="0.8684210777282715" green="0.8684210777282715" blue="0.8684210777282715" />
                     </value>
                  </ColorPicker>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content>
         <font>
            <Font size="15.0" />
         </font>
      </TitledPane>
      <CheckBox fx:id="chkShowCoordinates" mnemonicParsing="false" text="Afficher les coordonnées">
         <font>
            <Font size="14.0" />
         </font>
         <padding>
            <Insets bottom="5.0" top="5.0" />
         </padding>
      </CheckBox>
      <ListView fx:id="listViewCoordinateMode" prefHeight="98.0" prefWidth="600.0" />
      <VBox prefHeight="200.0" prefWidth="100.0">
         <children>
            <Label text="Épaisseur bordures">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Slider fx:id="sliderBorderThickness" majorTickUnit="1.0" max="10.0" prefWidth="200.0" value="1.0" />
         </children>
      </VBox>
   </children>
</VBox>
