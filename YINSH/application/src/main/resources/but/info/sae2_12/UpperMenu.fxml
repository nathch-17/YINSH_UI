<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<MenuBar fx:id="UpperMenu" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8">
  <menus>
    <Menu mnemonicParsing="false" text="À propos">
      <items>
        <MenuItem mnemonicParsing="false" text="Close" />
      </items>
    </Menu>
    <Menu fx:id="MenuSaveLoad" mnemonicParsing="false" text="Charger/Sauvegarder">
      <items>
        <MenuItem fx:id="Load" mnemonicParsing="false" text="Charger" />
            <MenuItem fx:id="Save" mnemonicParsing="false" text="Sauvegarder" />
      </items>
    </Menu>
  </menus>
</MenuBar>
