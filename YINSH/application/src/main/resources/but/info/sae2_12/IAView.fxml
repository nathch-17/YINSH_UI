<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://fxml.com/fxml/1" 
      fx:controller="but.info.sae2_12.controllers.IAController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Configuration des Scores IA" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="120.0" prefWidth="130.0" />
            <ColumnConstraints minWidth="80.0" prefWidth="100.0" />
        </columnConstraints>
        <children>
            <Label text="Victoire :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtWinScore" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Anneau retiré :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtRingWeight" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Pion sur plateau :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPawnWeight" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Ligne de 4 :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtLineWeight" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Mobilité (Coups) :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMobilityWeight" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </children>
    </GridPane>

    <Separator/>

    <Label text="Avantage actuel (Noir / Blanc)" style="-fx-font-weight: bold;"/>
    <ProgressBar fx:id="progressEvaluation" maxWidth="Infinity" progress="0.5" 
                 style="-fx-accent: black; -fx-control-inner-background: white;"/>

    <Separator/>

    <Button text="Suggérer un coup efficace" maxWidth="Infinity" onAction="#onSuggererCoup"/>
</VBox>